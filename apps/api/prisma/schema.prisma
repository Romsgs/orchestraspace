generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum EventType {
  REHEARSAL
  GENERAL_REHEARSAL
  CONCERT
  SOUND_CHECK
  MEETING
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Instrument {
  PERCUSSION
  PIANO
  HARP
  VIOLIN
  VIOLA
  CELLO
  DOUBLE_BASS
  FLUTE
  OBOE
  CLARINET
  BASSOON
  TRUMPET
  FRENCH_HORN
  TROMBONE
  TUBA
}

enum DocumentVisibility {
  ADMINS_ONLY
  STAFF
  MEMBERS
  PUBLIC
}

model User {
  id                 String   @id @default(cuid()) @map("_id")
  email              String   @unique
  passwordHash       String
  name               String
  isSuperAdmin       Boolean  @default(false)
  isActive           Boolean  @default(true)
  emailVerifiedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships        Membership[]
  createdEvents      Event[] @relation("EventCreator")
  createdTrips       Trip[] @relation("TripCreator")
  uploadedDocuments  Document[] @relation("DocumentUploader")
  auditLogs          AuditLog[] @relation("AuditActor")
}

model Organization {
  id          String             @id @default(cuid()) @map("_id")
  name        String
  slug        String             @unique
  description String?
  timezone    String             @default("Europe/Sofia")
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships Membership[]
  events      Event[]
  trips       Trip[]
  documents   Document[]
  roles       Role[]
  auditLogs   AuditLog[]

  @@index([status])
}

model Membership {
  id             String           @id @default(cuid()) @map("_id")
  userId         String
  organizationId String
  status         MembershipStatus @default(ACTIVE)
  instrument     Instrument?
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  eventMusicians EventMusician[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model Role {
  id             String   @id @default(cuid()) @map("_id")
  name           String
  key            String
  description    String?
  isSystemRole   Boolean  @default(false)
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      MembershipRole[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@index([key])
}

model Permission {
  id          String @id @default(cuid()) @map("_id")
  key         String @unique
  description String?
  roles       RolePermission[]
}

model MembershipRole {
  id           String     @id @default(cuid()) @map("_id")
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid()) @map("_id")
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Invitation {
  id             String   @id @default(cuid()) @map("_id")
  email          String
  tokenHash      String   @unique
  organizationId String
  roleKeys       String[]
  instrument     Instrument?
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, email])
  @@index([expiresAt])
}

model Event {
  id             String      @id @default(cuid()) @map("_id")
  organizationId String
  type           EventType
  status         EventStatus @default(DRAFT)
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  timezone       String      @default("Europe/Sofia")
  venue          String?
  address        String?
  conductor      String?
  program        String?
  notes          String?
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("EventCreator", fields: [createdById], references: [id])
  rehearsalDetails RehearsalDetails?
  concertDetails   ConcertDetails?
  tripLinks        TripEvent[]
  musicians        EventMusician[]
  attachments      EventAttachment[]

  @@index([organizationId, startAt])
  @@index([organizationId, status, startAt])
}

model RehearsalDetails {
  eventId            String  @id @map("_id")
  studyMaterialsNote String?
  event              Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ConcertDetails {
  eventId          String   @id @map("_id")
  requiredClothing String?
  bringStand       Boolean  @default(false)
  bringLights      Boolean  @default(false)
  arrivalAt        DateTime?
  setupAt          DateTime?
  additionalNotes  String?
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Trip {
  id             String     @id @default(cuid()) @map("_id")
  organizationId String
  title          String
  description    String?
  status         TripStatus @default(PLANNING)
  startAt        DateTime
  endAt          DateTime
  timezone       String     @default("Europe/Sofia")
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TripCreator", fields: [createdById], references: [id])
  eventLinks   TripEvent[]
  stops        TripStop[]

  @@index([organizationId, startAt])
}

model TripEvent {
  id        String   @id @default(cuid()) @map("_id")
  tripId    String
  eventId   String
  sortOrder Int      @default(0)
  notes     String?
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([tripId, eventId])
  @@index([eventId])
}

model EventMusician {
  id           String     @id @default(cuid()) @map("_id")
  eventId      String
  membershipId String
  createdAt    DateTime   @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([eventId, membershipId])
  @@index([eventId])
  @@index([membershipId])
}

model TripStop {
  id          String   @id @default(cuid()) @map("_id")
  tripId      String
  name        String
  city        String?
  country     String?
  address     String?
  arrivalAt   DateTime?
  departureAt DateTime?
  sortOrder   Int      @default(0)
  notes       String?
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sortOrder])
}

model Document {
  id             String             @id @default(cuid()) @map("_id")
  organizationId String
  uploadedById   String
  title          String
  description    String?
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      BigInt
  visibility     DocumentVisibility @default(ADMINS_ONLY)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  eventLinks   EventAttachment[]

  @@index([organizationId, createdAt])
}

model EventAttachment {
  id         String   @id @default(cuid()) @map("_id")
  eventId    String
  documentId String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([eventId, documentId])
}

model AuditLog {
  id             String   @id @default(cuid()) @map("_id")
  actorId        String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  sid       String   @id @map("_id")
  data      Json
  expiresAt DateTime

  @@index([expiresAt])
}
